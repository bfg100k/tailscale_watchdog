#!/bin/sh
# ==============================================================================
# Tailscale Watchdog
# ==============================================================================
# Platforms: Debian / OpenWrt (POSIX sh / BusyBox ash)
#
# Checks:
#   - Tailscale interface
#   - Tailscale data-plane connectivity OR daemon status
#
# Remediation:
#   1. Restart Tailscale daemon
#   2. Reboot once (optional)
#   3. Activate ZeroTier fallback (optional)
#
# Exceptions:
#   - Do not increment failure counter when WAN is unavailable.
#   - Restart network stack only once per WAN outage.
#   - Reset failure counter when Tailscale recovers.
# ==============================================================================

# --- USER CONFIGURATION ---

# Space-separated Tailnet IPs and/or Tailscale ACL tags
# Tags must use the tag: prefix.
# ANY one reachable target is sufficient.
TW_PING_TARGETS="100.64.0.1 tag:server tag:router"

# ZeroTier network ID (blank to disable fallback)
TW_ZT_NETWORK_ID="abcdef0123456789"

# Reboot if enabled (1 = enabled, 0 = disabled)
TW_FLAG_REBOOT=1

# Consecutive failures before ZeroTier escalation
TW_MAX_FAIL=3

# Seconds between completed watchdog checks.
# The next check starts this many seconds after the previous check finishes.
TW_INTERVAL=60

# Refresh tag-to-peer IP mappings every N watchdog checks.
# Direct IP targets are unaffected. The first refresh occurs on startup.
TW_TAG_CACHE_INTERVAL=10

# Log levels: 1 = DEBUG, 2 = INFO, 3 = WARN, 4 = ERROR
# INFO is disabled by default to avoid one journal/syslog entry per interval.
: "${LOG:=3}"

# Leave empty when managed by systemd/procd; they capture stdout/stderr.
# Set to a syslog tag if direct logger integration is preferred.
USE_LOGGER=""


# --- LOG HELPERS ---

_die() {
    echo "FATAL ERROR: $1" >&2
    if [ -n "$USE_LOGGER" ]; then
        logger -t "$USE_LOGGER" "FATAL ERROR: $1"
    fi
    exit 1
}

_err() {
    if [ "$LOG" -le 4 ]; then
        echo "ERROR: $1" >&2
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "ERROR: $1"
    fi
    return 0
}

_warn() {
    if [ "$LOG" -le 3 ]; then
        echo "WARN: $1"
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "WARN: $1"
    fi
    return 0
}

_info() {
    if [ "$LOG" -le 2 ]; then
        echo "INFO: $1"
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "INFO: $1"
    fi
    return 0
}

_debug() {
    if [ "$LOG" -le 1 ]; then
        echo "DEBUG: $1"
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "DEBUG: $1"
    fi
    return 0
}

_quit() {
    _info "$1"
    exit 0
}


# --- INITIALISATION ---

_quit_if_no_root_privileges() {
    if [ "$(id -u)" -ne 0 ]; then
        _die "This script requires root privileges."
    fi
}

validate_config() {
    case "$TW_MAX_FAIL" in
        ''|*[!0-9]*|0*)
            _die "TW_MAX_FAIL must be a positive integer."
            ;;
    esac

    if [ "$TW_MAX_FAIL" -lt 3 ]; then
        _die "TW_MAX_FAIL must be at least 3."
    fi

    case "$TW_FLAG_REBOOT" in
        0|1) ;;
        *) _die "TW_FLAG_REBOOT must be 0 or 1." ;;
    esac

    case "$LOG" in
        1|2|3|4) ;;
        *) _die "LOG must be between 1 and 4." ;;
    esac

    case "$TW_INTERVAL" in
        ''|*[!0-9]*|0)
            _die "TW_INTERVAL must be a positive integer (seconds)."
            ;;
    esac

    case "$TW_TAG_CACHE_INTERVAL" in
        ''|*[!0-9]*|0*)
            _die "TW_TAG_CACHE_INTERVAL must be a positive integer (checks)."
            ;;
    esac

    if [ -n "$TW_ZT_NETWORK_ID" ]; then
        case "$TW_ZT_NETWORK_ID" in
            *[!a-fA-F0-9]*)
                _die "Invalid ZeroTier network ID."
                ;;
        esac

        if [ "${#TW_ZT_NETWORK_ID}" -ne 16 ]; then
            _die "ZeroTier network ID must contain 16 hexadecimal characters."
        fi
    fi
}

init_environment() {
    umask 077

    if [ -f /etc/openwrt_release ]; then
        IS_OPENWRT=1
        PERSIST_DIR="/usr/lib/ts_watchdog"
        TAILSCALE_SERVICE_FN=manage_tailscale_openwrt
        ZEROTIER_SERVICE_FN=manage_zerotier_openwrt
        NETWORK_RESTART_FN=restart_network_openwrt
        if command -v jsonfilter >/dev/null 2>&1; then
            TAG_IP_PARSER_FN=get_tag_peer_ips_jsonfilter
        fi
    else
        IS_OPENWRT=0
        PERSIST_DIR="/var/lib/ts_watchdog"
        TAILSCALE_SERVICE_FN=manage_tailscale_systemd
        ZEROTIER_SERVICE_FN=manage_zerotier_systemd
        if command -v systemctl >/dev/null 2>&1; then
            NETWORK_RESTART_FN=restart_network_systemctl
        elif command -v ifdown >/dev/null 2>&1 &&
             command -v ifup >/dev/null 2>&1; then
            NETWORK_RESTART_FN=restart_network_ifupdown
        else
            NETWORK_RESTART_FN=restart_network_unavailable
        fi
        if command -v jq >/dev/null 2>&1; then
            TAG_IP_PARSER_FN=get_tag_peer_ips_jq
        fi
    fi

    # Resolve binaries once, rather than searching PATH on every iteration.
    TAILSCALE_BIN=$(command -v tailscale 2>/dev/null || :)
    ZEROTIER_BIN=$(command -v zerotier-cli 2>/dev/null || :)

    # Select the interface probe once, rather than checking command
    # availability on every watchdog iteration.
    if command -v ip >/dev/null 2>&1; then
        INTERFACE_CHECK_FN=has_tailscale_interface_ip
    elif command -v ifconfig >/dev/null 2>&1; then
        INTERFACE_CHECK_FN=has_tailscale_interface_ifconfig
    else
        _die "Neither ip nor ifconfig is available."
    fi

    # Determine once whether ACL-tag expansion is needed.
    case " $TW_PING_TARGETS " in
        *" tag:"*) HAS_TAG_TARGETS=1 ;;
        *) HAS_TAG_TARGETS=0 ;;
    esac

    # Validate the JSON parser once if ACL tags are configured.
    if [ "$HAS_TAG_TARGETS" -eq 1 ]; then
        [ -n "$TAG_IP_PARSER_FN" ] ||
            _die "Required Tailscale JSON parser is unavailable."
    fi

    VOLATILE_DIR="/tmp/ts_watchdog"

    mkdir -p "$VOLATILE_DIR" ||
        _die "Unable to create volatile directory."

    COUNTER_FILE="$VOLATILE_DIR/fail_count"
    WAN_FLAG_FILE="$VOLATILE_DIR/wan_restart_marker"
    STATUS_FILE="$VOLATILE_DIR/tailscale_status.json"
    PERSIST_MARKER="$PERSIST_DIR/reboot_marker"

    # Cache is refreshed on the first check, then every configured interval.
    TAG_CACHE_AGE=$TW_TAG_CACHE_INTERVAL
    TAG_IP_CACHE_VALID=0
    PING_TARGET_CACHE=
}


# --- SERVICE MANAGERS ---

manage_tailscale_openwrt() {
    /etc/init.d/tailscale "$1"
}

manage_tailscale_systemd() {
    systemctl "$1" tailscaled
}

manage_zerotier_openwrt() {
    /etc/init.d/zerotier "$1"
}

manage_zerotier_systemd() {
    systemctl "$1" zerotier-one
}

# The selected function names are fixed during initialisation.
manage_tailscale() {
    "$TAILSCALE_SERVICE_FN" "$1"
}

manage_zerotier() {
    "$ZEROTIER_SERVICE_FN" "$1"
}


# --- NETWORK HELPERS ---

has_tailscale_interface_ip() {
    ip link show tailscale0 >/dev/null 2>&1
}

has_tailscale_interface_ifconfig() {
    ifconfig tailscale0 >/dev/null 2>&1
}

has_tailscale_interface() {
    "$INTERFACE_CHECK_FN"
}

is_wan_available() {
    ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1
}

restart_network_openwrt() {
    /etc/init.d/network restart
}

restart_network_systemctl() {
    systemctl restart networking || systemctl restart NetworkManager
}

restart_network_ifupdown() {
    ifdown -a && ifup -a
}

restart_network_unavailable() {
    _err "No supported network restart method found."
    return 1
}

restart_network() {
    if [ -f "$WAN_FLAG_FILE" ]; then
        _warn "WAN is down. Network stack was already restarted. Standing by."
        return 0
    fi

    _warn "WAN unavailable. Restarting network stack..."
    touch "$WAN_FLAG_FILE" ||
        _err "Unable to create WAN restart marker."

    "$NETWORK_RESTART_FN"
}


# --- TAILSCALE JSON HELPERS ---

# Retrieve status once when refreshing the tag cache.
get_tailscale_status() {
    "$TAILSCALE_BIN" status --json > "$STATUS_FILE" 2>/dev/null
}

# OpenWrt parser.
get_tag_peer_ips_jsonfilter() {
    tag=$1

    jsonfilter -i "$STATUS_FILE" -e '@.Peer.*' |
        while IFS= read -r peer; do
            [ -n "$peer" ] || continue

            online=$(printf '%s\n' "$peer" |
                jsonfilter -e '@.Online' 2>/dev/null)
            [ "$online" = "true" ] || continue

            printf '%s\n' "$peer" |
                jsonfilter -e '@.Tags[*]' 2>/dev/null |
                grep -F -x "$tag" >/dev/null 2>&1 || continue

            printf '%s\n' "$peer" |
                jsonfilter -e '@.TailscaleIPs[*]' 2>/dev/null
        done
}

# Debian parser.
get_tag_peer_ips_jq() {
    jq -r --arg tag "$1" '
        (.Peer // {})
        | .[]
        | select(.Online == true)
        | select((.Tags // []) | index($tag))
        | .TailscaleIPs[]?
    ' "$STATUS_FILE" 2>/dev/null
}

get_tag_peer_ips() {
    "$TAG_IP_PARSER_FN" "$1"
}

# Rebuild the resolved target list atomically in memory. Direct IP targets
# are copied unchanged; tag targets are expanded from one status snapshot.
# If status retrieval fails, retain the previous cache when one exists.
refresh_ping_target_cache() {
    new_cache=
    has_tag_targets=0

    for configured_target in $TW_PING_TARGETS; do
        case "$configured_target" in
            tag:*) has_tag_targets=1 ;;
            *) new_cache="$new_cache $configured_target" ;;
        esac
    done

    if [ "$has_tag_targets" -eq 1 ]; then
        if ! get_tailscale_status; then
            _err "Unable to refresh Tailscale tag peer cache."
            [ "$TAG_IP_CACHE_VALID" -eq 1 ] && return 0
            PING_TARGET_CACHE=$new_cache
            return 1
        fi

        for configured_target in $TW_PING_TARGETS; do
            case "$configured_target" in
                tag:*)
                    tag_ips=$(get_tag_peer_ips "$configured_target") || tag_ips=
                    if [ -z "$tag_ips" ]; then
                        _debug "No online Tailscale peers found for tag: $configured_target"
                    else
                        for cached_ip in $tag_ips; do
                            new_cache="$new_cache $cached_ip"
                        done
                    fi
                    ;;
            esac
        done
    fi

    # Strip leading whitespace and publish the complete new cache.
    PING_TARGET_CACHE=${new_cache# }
    TAG_IP_CACHE_VALID=1
    _debug "Tailscale target cache refreshed."
    return 0
}

refresh_ping_target_cache_if_due() {
    [ "$HAS_TAG_TARGETS" -eq 1 ] || return 0

    if [ "$TAG_CACHE_AGE" -ge "$TW_TAG_CACHE_INTERVAL" ]; then
        refresh_ping_target_cache || :
        TAG_CACHE_AGE=0
    fi
}

# --- TAILSCALE CHECKS ---

check_tailscale_targets() {
    if [ -z "$TAILSCALE_BIN" ]; then
        _err "Tailscale CLI unavailable."
        return 1
    fi

    refresh_ping_target_cache_if_due

    for target in $PING_TARGET_CACHE; do
        _debug "Checking Tailscale target: $target"

        if "$TAILSCALE_BIN" ping --c=1 --timeout=5s "$target" >/dev/null 2>&1; then
            _info "Tailscale target reachable: $target"
            return 0
        fi
    done

    _warn "None of the cached Tailscale targets are reachable."
    return 1
}

check_tailscale_status() {
    if [ -z "$TAILSCALE_BIN" ] || ! "$TAILSCALE_BIN" status >/dev/null 2>&1; then
        _warn "Tailscale daemon status check failed."
        return 1
    fi

    _info "Tailscale daemon status OK."
    return 0
}


# --- ZEROTIER CHECKS ---

# Get status of the configured ZeroTier network.
get_zerotier_network_status() {
    "$ZEROTIER_BIN" listnetworks 2>/dev/null |
        awk -v nwid="$TW_ZT_NETWORK_ID" '
            $1 == "200" && $2 == "listnetworks" && $3 == nwid {
                print $6
                found = 1
            }
            END {
                if (!found) exit 1
            }
        '
}

is_zerotier_network_ok() {
    ZT_STATUS=$(get_zerotier_network_status) || return 1
    [ "$ZT_STATUS" = "OK" ]
}

activate_zerotier() {
    if [ -z "$TW_ZT_NETWORK_ID" ]; then
        _warn "ZeroTier fallback is not configured."
        return 1
    fi

    if [ -z "$ZEROTIER_BIN" ]; then
        _err "zerotier-cli unavailable."
        return 1
    fi

    if is_zerotier_network_ok; then
        _info "ZeroTier network verified ONLINE (OK)."
        return 0
    fi

    _warn "Starting ZeroTier service..."

    if ! manage_zerotier start; then
        _err "Unable to start ZeroTier service."
        return 1
    fi

    ZT_STATUS=$(get_zerotier_network_status)

    # Join only if the network is not already listed.
    if [ -z "$ZT_STATUS" ]; then
        _info "Joining ZeroTier network: $TW_ZT_NETWORK_ID"

        if ! "$ZEROTIER_BIN" join "$TW_ZT_NETWORK_ID"; then
            _err "Unable to join ZeroTier network."
            return 1
        fi
    else
        _warn "ZeroTier network membership status: $ZT_STATUS"
    fi

    # Verify actual network membership status.
    if is_zerotier_network_ok; then
        _info "ZeroTier network verified ONLINE (OK)."
        return 0
    fi

    _warn "ZeroTier network has not reached OK status yet."
    return 1
}


# --- FAILURE COUNTER ---

load_fail_count() {
    FAIL_COUNT=0

    if [ -f "$COUNTER_FILE" ]; then
        stored_count=$(cat "$COUNTER_FILE" 2>/dev/null)

        case "$stored_count" in
            ''|*[!0-9]*|0*)
                _warn "Invalid failure counter. Resetting."
                FAIL_COUNT=0
                ;;
            *)
                FAIL_COUNT=$stored_count
                ;;
        esac
    fi
}

save_fail_count() {
    printf '%s\n' "$FAIL_COUNT" > "$COUNTER_FILE" ||
        _die "Unable to save failure counter."
}

reset_fail_count() {
    FAIL_COUNT=0
    rm -f "$COUNTER_FILE" "$PERSIST_MARKER"
    _info "Tailscale recovered. Failure counter and reboot marker cleared."
}


# --- REMEDIATION ---

remediate_failure() {

    # Persistent marker means reboot was already attempted.
    if [ -f "$PERSIST_MARKER" ]; then
        _warn "Post-reboot failure detected. Skipping further reboot attempts."
        rm -f "$PERSIST_MARKER"
        FAIL_COUNT=$TW_MAX_FAIL
    else
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi

    save_fail_count

    _warn "Consecutive Tailscale failures: $FAIL_COUNT / $TW_MAX_FAIL"

    # STEP 1: Restart Tailscale.
    if [ "$FAIL_COUNT" -eq 1 ]; then
        _warn "Escalation 1: Restarting Tailscale daemon."

        if ! manage_tailscale restart; then
            _err "Tailscale daemon restart failed."
            return 1
        fi

        return 0
    fi

    # STEP 2: Reboot once (optional).
    if [ "$FAIL_COUNT" -eq 2 ] && [ "$TW_FLAG_REBOOT" -eq 1 ]; then
        _warn "Escalation 2: Preparing system reboot."

        mkdir -p "$PERSIST_DIR" ||
            _die "Unable to create persistent directory."

        touch "$PERSIST_MARKER" ||
            _die "Unable to create reboot marker."

        sync
        reboot
        return $?
    fi

    # STEP 3: Activate ZeroTier.
    if [ "$FAIL_COUNT" -ge "$TW_MAX_FAIL" ]; then
        _warn "Escalation 3: Activating ZeroTier fallback."
        activate_zerotier
        return $?
    fi

    _info "Waiting for next watchdog execution."
    return 0
}


# --- MAIN WATCHDOG LOGIC ---

main() {
    _info "Executing Tailscale watchdog checks..."

    TS_FAILED=0

    # CHECK 1: Tailscale interface.
    if ! has_tailscale_interface; then
        _warn "Tailscale interface tailscale0 is missing."
        TS_FAILED=1
    else
        _info "Check 1: Tailscale interface OK."

        # CHECK 2: Data-plane or daemon status.
        if [ -n "$TW_PING_TARGETS" ]; then
            check_tailscale_targets || TS_FAILED=1
        else
            check_tailscale_status || TS_FAILED=1
        fi
    fi

    # SUCCESS: Tailscale is healthy.
    if [ "$TS_FAILED" -eq 0 ]; then
        reset_fail_count
        rm -f "$WAN_FLAG_FILE"
        _info "All Tailscale checks passed."
        return 0
    fi

    _warn "Tailscale health check failed."

    # EXCEPTION: WAN unavailable.
    if ! is_wan_available; then
        _warn "Public Internet WAN unavailable."
        restart_network
        return 1
    fi

    # WAN restored: clear stale marker.
    if [ -f "$WAN_FLAG_FILE" ]; then
        _info "WAN connectivity restored."
        rm -f "$WAN_FLAG_FILE"
    fi

    # WAN available: proceed with Tailscale remediation.
    remediate_failure
}

# --- PROCESS LIFECYCLE ---

startup() {
    _quit_if_no_root_privileges
    validate_config
    init_environment
    load_fail_count
}

run_loop() {
    # Run in the foreground. systemd/procd supervise this process directly.
    # A failed health check is not a process failure; main() reports it and
    # the next check runs after TW_INTERVAL seconds.
    trap 'exit 0' HUP INT TERM

    while :; do
        main || :
        TAG_CACHE_AGE=$((TAG_CACHE_AGE + HAS_TAG_TARGETS))
        sleep "$TW_INTERVAL" ||
            _die "Unable to sleep for TW_INTERVAL=$TW_INTERVAL seconds."
    done
}

case "${1:-}" in
    --once)
        startup
        main
        ;;
    --loop|'')
        startup
        run_loop
        ;;
    --help|-h)
        cat <<EOF
Usage: $0 [--loop|--once|--help]
  --loop  Run continuously (default); intended for systemd/procd.
  --once  Run one health check and exit.
  --help  Show this help.

TW_INTERVAL=$TW_INTERVAL seconds between completed checks.
TW_TAG_CACHE_INTERVAL=$TW_TAG_CACHE_INTERVAL checks between tag cache refreshes.
EOF
        ;;
    *)
        echo "Unknown option: $1" >&2
        echo "Usage: $0 [--loop|--once|--help]" >&2
        exit 2
        ;;
esac

