#!/bin/sh
# ==============================================================================
# Tailscale Watchdog
# ==============================================================================
# Platforms: Debian / OpenWrt (POSIX sh / BusyBox ash)
#
# Checks:
#   - Tailscale interface
#   - Tailscale data-plane connectivity OR daemon status
#
# Remediation:
#   1. Restart Tailscale daemon
#   2. Reboot once (optional)
#   3. Activate ZeroTier fallback (optional)
#
# Exceptions:
#   - Do not increment failure counter when WAN is unavailable.
#   - Restart network stack only once per WAN outage.
#   - Reset failure counter when Tailscale recovers.
# ==============================================================================

# --- CONFIGURATION ---

# Configuration is kept outside the executable so package/script updates do
# not overwrite local settings. The file is shell syntax and must be trusted.
CONFIG_FILE="/etc/tailscale_watchdog.conf"

# Defaults (overridden by CONFIG_FILE when it exists).
TW_PING_TARGETS=""
TW_PING_ALWAYS=""
TW_ZT_NETWORK_ID=""
TW_FAIL_REBOOT=""
TW_FAIL_START_ZT=""
TW_STOP_ZT_ON_RECOVERY=0
TW_ZT_RECOVERY_GRACE=600
TW_ZT_IDLE_CHECKS=3
TW_ZT_IDLE_INTERVAL=60
TW_STARTUP_DELAY=60
TW_CHECK_INTERVAL=60
TW_TAG_CACHE_INTERVAL=10
TW_DISCORD_WEBHOOK=""

# Log levels: 1 = DEBUG, 2 = INFO, 3 = WARN, 4 = ERROR
: "${LOG:=2}"

# Leave empty when managed by systemd/procd; they capture stdout/stderr.
# Set to a syslog tag if direct logger integration is preferred.
USE_LOGGER=""

if [ -r "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE" || {
        echo "FATAL ERROR: Unable to load $CONFIG_FILE." >&2
        exit 1
    }
fi

# --- LOG HELPERS ---

_die() {
    echo "FATAL ERROR: $1" >&2
    if [ -n "$USE_LOGGER" ]; then
        logger -t "$USE_LOGGER" "FATAL ERROR: $1"
    fi
    exit 1
}

_err() {
    if [ "$LOG" -le 4 ]; then
        echo "ERROR: $1" >&2
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "ERROR: $1"
    fi
    return 0
}

_warn() {
    if [ "$LOG" -le 3 ]; then
        echo "WARN: $1"
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "WARN: $1"
    fi
    return 0
}

_info() {
    if [ "$LOG" -le 2 ]; then
        echo "INFO: $1"
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "INFO: $1"
    fi
    return 0
}

_debug() {
    if [ "$LOG" -le 1 ]; then
        echo "DEBUG: $1"
        [ -n "$USE_LOGGER" ] &&
            logger -t "$USE_LOGGER" "DEBUG: $1"
    fi
    return 0
}

_quit() {
    _info "$1"
    exit 0
}


# --- INITIALISATION ---

_quit_if_no_root_privileges() {
    if [ "$(id -u)" -ne 0 ]; then
        _die "This script requires root privileges."
    fi
}

# Validate an optional signed decimal integer and normalise leading zeroes.
# The supported range is deliberately bounded to avoid shell arithmetic
# overflow on embedded systems.
_normalize_threshold() {
    threshold_value=$1

    case "$threshold_value" in
        '') NORMALIZED_THRESHOLD=0; return 0 ;;
        -*) threshold_sign=-; threshold_digits=${threshold_value#-} ;;
        +*) threshold_sign=; threshold_digits=${threshold_value#+} ;;
        *) threshold_sign=; threshold_digits=$threshold_value ;;
    esac

    case "$threshold_digits" in
        ''|*[!0-9]*) return 1 ;;
    esac

    [ "${#threshold_digits}" -le 9 ] || return 1

    while [ "${threshold_digits#0}" != "$threshold_digits" ]; do
        threshold_digits=${threshold_digits#0}
    done
    [ -n "$threshold_digits" ] || threshold_digits=0

    NORMALIZED_THRESHOLD="${threshold_sign}${threshold_digits}"
    [ "$NORMALIZED_THRESHOLD" != "-0" ] || NORMALIZED_THRESHOLD=0
    return 0
}

validate_config() {
    _normalize_threshold "$TW_FAIL_REBOOT" ||
        _die "TW_FAIL_REBOOT must be an optional signed integer (maximum 9 digits)."
    REBOOT_THRESHOLD=$NORMALIZED_THRESHOLD

    _normalize_threshold "$TW_FAIL_START_ZT" ||
        _die "TW_FAIL_START_ZT must be an optional signed integer (maximum 9 digits)."
    ZT_THRESHOLD=$NORMALIZED_THRESHOLD

    [ "$REBOOT_THRESHOLD" -ne "$ZT_THRESHOLD" ] ||
        [ "$REBOOT_THRESHOLD" -le 0 ] ||
        _die "TW_FAIL_REBOOT and TW_FAIL_START_ZT must not be equal when both are enabled."

    case "$TW_STOP_ZT_ON_RECOVERY" in
        0|1) ;;
        *) _die "TW_STOP_ZT_ON_RECOVERY must be 0 or 1." ;;
    esac
    case "$TW_ZT_RECOVERY_GRACE" in
        ''|*[!0-9]*) _die "TW_ZT_RECOVERY_GRACE must be a non-negative integer." ;;
    esac
    [ "${#TW_ZT_RECOVERY_GRACE}" -le 9 ] || _die "TW_ZT_RECOVERY_GRACE is too large."
    case "$TW_ZT_IDLE_CHECKS" in
        ''|*[!0-9]*|0) _die "TW_ZT_IDLE_CHECKS must be a positive integer." ;;
    esac
    [ "${#TW_ZT_IDLE_CHECKS}" -le 9 ] || _die "TW_ZT_IDLE_CHECKS is too large."
    case "$TW_ZT_IDLE_INTERVAL" in
        ''|*[!0-9]*|0) _die "TW_ZT_IDLE_INTERVAL must be a positive integer." ;;
    esac
    [ "${#TW_ZT_IDLE_INTERVAL}" -le 9 ] || _die "TW_ZT_IDLE_INTERVAL is too large."

    if [ "$ZT_THRESHOLD" -gt 0 ]; then
        if [ -z "$TW_ZT_NETWORK_ID" ]; then
            _die "TW_ZT_NETWORK_ID is required when TW_FAIL_START_ZT is enabled."
        fi

        case "$TW_ZT_NETWORK_ID" in
            *[!a-fA-F0-9]*) _die "Invalid ZeroTier network ID." ;;
        esac

        if [ "${#TW_ZT_NETWORK_ID}" -ne 16 ]; then
            _die "ZeroTier network ID must contain 16 hexadecimal characters."
        fi
    fi

    case "$LOG" in
        1|2|3|4) ;;
        *) _die "LOG must be between 1 and 4." ;;
    esac

    case "$TW_CHECK_INTERVAL" in
        ''|*[!0-9]*|0)
            _die "TW_CHECK_INTERVAL must be a positive integer (seconds)."
            ;;
    esac

    case "$TW_TAG_CACHE_INTERVAL" in
        ''|*[!0-9]*|0*)
            _die "TW_TAG_CACHE_INTERVAL must be a positive integer (checks)."
            ;;
    esac
}

init_environment() {
    umask 077

    if [ -f /etc/openwrt_release ]; then
        IS_OPENWRT=1
        PERSIST_DIR="/usr/lib/ts_watchdog"
        TAILSCALE_SERVICE_FN=manage_tailscale_openwrt
        ZEROTIER_SERVICE_FN=manage_zerotier_openwrt
        ZEROTIER_ACTIVE_CHECK_FN=zerotier_service_active_openwrt
        NETWORK_RESTART_FN=restart_network_openwrt
        if command -v jsonfilter >/dev/null 2>&1; then
            TAG_IP_PARSER_FN=get_tag_peer_ips_jsonfilter
            SELF_IP_PARSER_FN=get_self_tailscale_ips_jsonfilter
        fi
    else
        IS_OPENWRT=0
        PERSIST_DIR="/var/lib/ts_watchdog"
        TAILSCALE_SERVICE_FN=manage_tailscale_systemd
        ZEROTIER_SERVICE_FN=manage_zerotier_systemd
        ZEROTIER_ACTIVE_CHECK_FN=zerotier_service_active_systemd
        if command -v systemctl >/dev/null 2>&1; then
            NETWORK_RESTART_FN=restart_network_systemctl
        elif command -v ifdown >/dev/null 2>&1 &&
             command -v ifup >/dev/null 2>&1; then
            NETWORK_RESTART_FN=restart_network_ifupdown
        else
            NETWORK_RESTART_FN=restart_network_unavailable
        fi
        if command -v jq >/dev/null 2>&1; then
            TAG_IP_PARSER_FN=get_tag_peer_ips_jq
            SELF_IP_PARSER_FN=get_self_tailscale_ips_jq
        fi
    fi

    # Resolve executable paths once. Runtime checks can then assume required
    # commands are available without repeating PATH lookups or existence tests.
    TAILSCALE_BIN=$(command -v tailscale 2>/dev/null || :)
    [ -n "$TAILSCALE_BIN" ] || _die "Tailscale CLI is unavailable."

    ZEROTIER_BIN=
    if [ "$ZT_THRESHOLD" -gt 0 ]; then
        ZEROTIER_BIN=$(command -v zerotier-cli 2>/dev/null || :)
        [ -n "$ZEROTIER_BIN" ] ||
            _die "ZeroTier escalation is enabled, but zerotier-cli is unavailable."
    fi

    CONNTRACK_BIN=
    if [ "$TW_STOP_ZT_ON_RECOVERY" -eq 1 ] && [ "$ZT_THRESHOLD" -gt 0 ]; then
        CONNTRACK_BIN=$(command -v conntrack 2>/dev/null || :)
        [ -n "$CONNTRACK_BIN" ] ||
            _warn "Automatic ZeroTier cleanup is enabled, but conntrack is unavailable. ZeroTier will not be stopped."
    fi

    CURL_BIN=
    if [ -n "$TW_DISCORD_WEBHOOK" ]; then
        CURL_BIN=$(command -v curl 2>/dev/null || :)
        [ -n "$CURL_BIN" ] ||
            _warn "Discord notifications are configured, but curl is unavailable; notifications are disabled."
    fi

    # Select the interface probe once, rather than checking command
    # availability on every watchdog iteration.
    if command -v ip >/dev/null 2>&1; then
        INTERFACE_CHECK_FN=has_tailscale_interface_ip
    elif command -v ifconfig >/dev/null 2>&1; then
        INTERFACE_CHECK_FN=has_tailscale_interface_ifconfig
    else
        _die "Neither ip nor ifconfig is available."
    fi

    if command -v ip >/dev/null 2>&1; then
        ZT_INTERFACE_IP_FN=get_interface_ips_ip
    elif command -v ifconfig >/dev/null 2>&1; then
        ZT_INTERFACE_IP_FN=get_interface_ips_ifconfig
    else
        ZT_INTERFACE_IP_FN=
    fi

    # Normalise this option once; the main check loop only needs a boolean.
    PING_ALWAYS=0
    if [ -n "$TW_PING_ALWAYS" ] && [ "$TW_PING_ALWAYS" != 0 ]; then
        PING_ALWAYS=1
    fi

    # Determine once whether targets are configured and whether any require
    # ACL-tag expansion.
    HAS_PING_TARGETS=0
    HAS_TAG_TARGETS=0
    for configured_target in $TW_PING_TARGETS; do
        HAS_PING_TARGETS=1
        case "$configured_target" in
            tag:*) HAS_TAG_TARGETS=1 ;;
        esac
    done

    # A status JSON parser is required for self-IP exclusion whenever targets
    # are configured, and for tag expansion when ACL tags are present.
    if [ "$HAS_TAG_TARGETS" -eq 1 ]; then
        [ -n "$SELF_IP_PARSER_FN" ] ||
            _die "Required Tailscale self-IP JSON parser is unavailable."
        [ -n "$TAG_IP_PARSER_FN" ] ||
            _die "Required Tailscale tag JSON parser is unavailable."
    fi

    VOLATILE_DIR="/tmp/ts_watchdog"

    mkdir -p "$VOLATILE_DIR" ||
        _die "Unable to create volatile directory."

    COUNTER_FILE="$VOLATILE_DIR/fail_count"
    WAN_FLAG_FILE="$VOLATILE_DIR/wan_restart_marker"
    STATUS_FILE="$VOLATILE_DIR/tailscale_status.json"
    PERSIST_MARKER="$PERSIST_DIR/reboot_marker"
    ZT_ESCALATED_MARKER="$PERSIST_DIR/zerotier_escalated"
    ZT_OWNED_MARKER="$PERSIST_DIR/zerotier_owned"
    ZT_RESTORE_MARKER="$PERSIST_DIR/zerotier_restore"
    ZT_RECOVERY_FILE="$VOLATILE_DIR/zerotier_recovery_time"
    ZT_IDLE_COUNT_FILE="$VOLATILE_DIR/zerotier_idle_count"
    ZT_LAST_CHECK_FILE="$VOLATILE_DIR/zerotier_last_check"
    ZT_LAST_RX_FILE="$VOLATILE_DIR/zerotier_last_rx"
    ZT_LAST_TX_FILE="$VOLATILE_DIR/zerotier_last_tx"

    # Cache is refreshed on the first check, then every configured interval.
    TAG_CACHE_AGE=$TW_TAG_CACHE_INTERVAL
    TAG_IP_CACHE_VALID=0
    PING_TARGET_CACHE=
}

print_config() {
    _info "Performing health check every $TW_CHECK_INTERVAL seconds."
    if [ "$HAS_PING_TARGETS" -eq 1 ]; then
	    if [ "$PING_ALWAYS" -eq 1 ]; then
            _info "Health check type - PING remote node ALWAYS"
        else
            _info "Health check type - PING remote node if no active connections found"
        fi
        [ "$HAS_TAG_TARGETS" -eq 1 ] &&
            _info "Refreshing PING Targets cache every $TW_TAG_CACHE_INTERVAL checks."
    else
        _info "Health check type - local tailscaled status"
    fi
    if [ "$REBOOT_THRESHOLD" -gt 0 ]; then
        _info "Rebooting system after $REBOOT_THRESHOLD consecutive failures."
    fi
	if [ "$ZT_THRESHOLD" -gt 0 ]; then
	    _info "Starting fallback ZeroTier service after $ZT_THRESHOLD consecutive failures."
		_info "Configured ZeroTier network ID is $TW_ZT_NETWORK_ID."
	fi
    if [ "$TW_STOP_ZT_ON_RECOVERY" -eq 1 ]; then
        _info "Automatic ZeroTier cleanup enabled (grace ${TW_ZT_RECOVERY_GRACE}s, ${TW_ZT_IDLE_CHECKS} idle checks ${TW_ZT_IDLE_INTERVAL}s apart)."
        [ -n "$CONNTRACK_BIN" ] ||
            _warn "conntrack unavailable; automatic ZeroTier cleanup will fail safe and leave the service running."
    fi
    if [ -n "$TW_DISCORD_WEBHOOK" ]; then
        _info "Discord webhook set. Will send notification when remediation is attempted."
    fi
}

# --- SERVICE MANAGERS ---

manage_tailscale_openwrt() {
    /etc/init.d/tailscale "$1"
}

manage_tailscale_systemd() {
    systemctl "$1" tailscaled
}

manage_zerotier_openwrt() {
    /etc/init.d/zerotier "$1"
}

manage_zerotier_systemd() {
    systemctl "$1" zerotier-one
}

# The selected function names are fixed during initialisation.
manage_tailscale() {
    "$TAILSCALE_SERVICE_FN" "$1"
}

manage_zerotier() {
    "$ZEROTIER_SERVICE_FN" "$1"
}

zerotier_service_active_systemd() {
    zt_state=$(systemctl show -p ActiveState --value zerotier-one 2>/dev/null) ||
        return 2

    case "$zt_state" in
        active|activating|reloading)
            return 0
            ;;
        inactive)
            return 1
            ;;
        *)
            return 2
            ;;
    esac
}

zerotier_service_active_openwrt() {
    command -v pidof >/dev/null 2>&1 || return 2

    if pidof zerotier-one >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

# --- NETWORK HELPERS ---

has_tailscale_interface_ip() {
    ip link show tailscale0 >/dev/null 2>&1
}

has_tailscale_interface_ifconfig() {
    ifconfig tailscale0 >/dev/null 2>&1
}

has_tailscale_interface() {
    "$INTERFACE_CHECK_FN"
}

is_wan_available() {
    ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1
}

restart_network_openwrt() {
    /etc/init.d/network restart
}

restart_network_systemctl() {
    systemctl restart networking || systemctl restart NetworkManager
}

restart_network_ifupdown() {
    ifdown -a && ifup -a
}

restart_network_unavailable() {
    _err "No supported network restart method found."
    return 1
}

restart_network() {
    if [ -f "$WAN_FLAG_FILE" ]; then
        _warn "WAN is down. Network stack was already restarted. Standing by."
        return 0
    fi

    _warn "WAN unavailable. Restarting network stack..."
    touch "$WAN_FLAG_FILE" ||
        _err "Unable to create WAN restart marker."

    "$NETWORK_RESTART_FN"
}

get_interface_ips_ip() {
    ip -o addr show dev "$1" 2>/dev/null |
        awk '{ split($4, a, "/"); if (a[1] != "") print a[1] }'
}

get_interface_ips_ifconfig() {
    ifconfig "$1" 2>/dev/null |
        awk '
            /inet addr:/ {
                split($2, a, ":")
                if (a[2] != "") print a[2]
            }
            /inet6 addr:/ {
                if ($3 != "") print $3
            }
            /^[[:space:]]*inet / {
                if ($2 != "") print $2
            }
        '
}

# --- TAILSCALE JSON HELPERS ---

# Retrieve status once when refreshing the tag cache.
get_tailscale_status() {
    "$TAILSCALE_BIN" status --json > "$STATUS_FILE" 2>/dev/null
}

# OpenWrt parser.
get_tag_peer_ips_jsonfilter() {
    jsonfilter -i "$STATUS_FILE" \
        -e '@.Peer[*][@.Online=true && @.Tags[*]="'"$1"'"].TailscaleIPs[*]' 2>/dev/null
}

# Debian parser.
get_tag_peer_ips_jq() {
    jq -r --arg tag "$1" '
        (.Peer // {})
        | .[]
        | select(.Online == true)
        | select((.Tags // []) | index($tag))
        | .TailscaleIPs[]?
    ' "$STATUS_FILE" 2>/dev/null
}

get_tag_peer_ips() {
    "$TAG_IP_PARSER_FN" "$1"
}

# Read this node's own Tailscale IPs from the same status snapshot used for
# tag expansion. Keeping this in the platform-specific parser avoids extra
# tailscale CLI calls during cache refreshes.
get_self_tailscale_ips_jsonfilter() {
    jsonfilter -i "$STATUS_FILE" -e '@.Self.TailscaleIPs[*]' 2>/dev/null
}

get_self_tailscale_ips_jq() {
    jq -r '.Self.TailscaleIPs[]?' "$STATUS_FILE" 2>/dev/null
}

get_self_tailscale_ips() {
    "$SELF_IP_PARSER_FN"
}

# Return success when the supplied address belongs to this node.
is_self_tailscale_ip() {
    candidate_ip=$1
    for self_ip in $SELF_TAILSCALE_IPS; do
        [ "$candidate_ip" = "$self_ip" ] && return 0
    done
    return 1
}

# Rebuild the resolved target list atomically in memory. Direct IP targets
# are copied unchanged unless they identify this node; tag targets are
# expanded from one status snapshot with this node excluded.
# If status retrieval fails, retain the previous cache when one exists.
refresh_ping_target_cache() {
    new_cache=
    target_count=0

    if [ "$HAS_PING_TARGETS" -eq 1 ]; then
        if [ "$HAS_TAG_TARGETS" -eq 1 ]; then
            if ! get_tailscale_status; then
                _err "Unable to refresh Tailscale target cache."
                [ "$TAG_IP_CACHE_VALID" -eq 1 ] && return 0
                PING_TARGET_CACHE=
                return 1
            fi
            SELF_TAILSCALE_IPS=$(get_self_tailscale_ips) || SELF_TAILSCALE_IPS=
        else
            SELF_TAILSCALE_IPS=$("$TAILSCALE_BIN" ip 2>/dev/null) || SELF_TAILSCALE_IPS=
        fi

        for configured_target in $TW_PING_TARGETS; do
            case "$configured_target" in
                tag:*)
                    tag_ips=$(get_tag_peer_ips "$configured_target") || tag_ips=
                    if [ -z "$tag_ips" ]; then
                        _warn "No online Tailscale peers found for tag: $configured_target"
                    else
                        for cached_ip in $tag_ips; do
                            if ! is_self_tailscale_ip "$cached_ip"; then
                                new_cache="$new_cache $cached_ip"
                                target_count=$((target_count + 1))
                            else
                                _debug "Skipping own Tailscale IP: $cached_ip"
                            fi
                        done
                    fi
                    ;;
                *)
                    if ! is_self_tailscale_ip "$configured_target"; then
                        new_cache="$new_cache $configured_target"
                        target_count=$((target_count + 1))
                    else
                        _warn "Ignoring own Tailscale IP ($configured_target) as a PING Target."
                    fi
                    ;;
            esac
        done
    fi

    # Strip leading whitespace and publish the complete new cache.
    PING_TARGET_CACHE=${new_cache# }
	_debug "Refreshed PING Targets cache: $PING_TARGET_CACHE"
    TAG_IP_CACHE_VALID=1
    _info "Tailscale target cache refreshed. Found $target_count targets."
    return 0
}

refresh_ping_target_cache_if_due() {
    [ "$HAS_PING_TARGETS" -eq 1 ] || return 0

    if [ "$TAG_CACHE_AGE" -ge "$TW_TAG_CACHE_INTERVAL" ]; then
        refresh_ping_target_cache || :
        TAG_CACHE_AGE=0
    fi
}

# --- TAILSCALE CHECKS ---

check_tailscale_targets() {
    refresh_ping_target_cache_if_due

    for target in $PING_TARGET_CACHE; do
        _debug "Checking Tailscale target: $target"

        if "$TAILSCALE_BIN" ping --tsmp --c=1 --timeout=5s "$target" >/dev/null 2>&1; then
            _info "Tailscale target reachable: $target"
            return 0
        fi
    done

    _warn "None of the cached Tailscale targets are reachable."
    return 1
}

# Return 0 when at least one remote peer is active, 1 when none are active,
# or 2 when the status query fails. Comment and blank lines are ignored.
check_tailscale_active_connections() {
    active_status=$("$TAILSCALE_BIN" status --active --self=false 2>/dev/null)
    status_rc=$?
    if [ "$status_rc" -ne 0 ]; then
        _warn "Unable to retrieve active Tailscale connections."
        return 2
    fi

    if printf '%s\n' "$active_status" | grep -Eqv '^#|^[[:space:]]*$'; then
        _debug "Active Tailscale connections detected."
        return 0
    fi

    _debug "No active Tailscale connections detected."
    return 1
}

check_tailscale_status() {
    if ! "$TAILSCALE_BIN" status >/dev/null 2>&1; then
        _warn "Tailscale daemon status check failed."
        return 1
    fi

    _info "Tailscale daemon status OK."
    return 0
}


# --- ZEROTIER CHECKS ---

# Get status of the configured ZeroTier network.
get_zerotier_network_status() {
    "$ZEROTIER_BIN" listnetworks 2>/dev/null |
        awk -v nwid="$TW_ZT_NETWORK_ID" '
            $1 == "200" && $2 == "listnetworks" && $3 == nwid {
                print $6
                found = 1
            }
            END {
                if (!found) exit 1
            }
        '
}

is_zerotier_network_ok() {
    ZT_STATUS=$(get_zerotier_network_status) || return 1
    [ "$ZT_STATUS" = "OK" ]
}

activate_zerotier() {
    if [ -z "$TW_ZT_NETWORK_ID" ]; then
        _warn "ZeroTier fallback is not configured."
        return 1
    fi

    # Only claim ownership when the service manager confirms that the
    # daemon was stopped before escalation. Unknown state is fail-safe.
    if [ "${ZT_RESTORING:-0}" -eq 1 ]; then
        ZT_NEEDS_OWNERSHIP=0
    else
        "$ZEROTIER_ACTIVE_CHECK_FN"
        zt_service_rc=$?

        case "$zt_service_rc" in
            0)
                ZT_NEEDS_OWNERSHIP=0
                ;;
            1)
                ZT_NEEDS_OWNERSHIP=1
                mkdir -p "$PERSIST_DIR" || {
                    _err "Unable to create persistent state directory for ZeroTier ownership."
                    return 1
                }
                ;;
            *)
                ZT_NEEDS_OWNERSHIP=0
                _warn "Unable to determine whether ZeroTier was already running; automatic cleanup ownership will not be claimed."
                ;;
        esac
    fi

    if is_zerotier_network_ok; then
        _info "ZeroTier network verified ONLINE (OK)."
        return 0
    fi

    _warn "Starting ZeroTier service..."

    if ! manage_zerotier start; then
        _err "Unable to start ZeroTier service."
        return 1
    fi

    if [ "$ZT_NEEDS_OWNERSHIP" -eq 1 ]; then
        touch "$ZT_OWNED_MARKER" ||
            _warn "Unable to record ZeroTier ownership; automatic cleanup will not be attempted."
    fi

    ZT_STATUS=$(get_zerotier_network_status)

    # Join only if the network is not already listed.
    if [ -z "$ZT_STATUS" ]; then
        _info "Joining ZeroTier network: $TW_ZT_NETWORK_ID"

        if ! "$ZEROTIER_BIN" join "$TW_ZT_NETWORK_ID"; then
            _err "Unable to join ZeroTier network."
            return 1
        fi
    else
        _warn "ZeroTier network membership status: $ZT_STATUS"
    fi

    # Verify actual network membership status.
    if is_zerotier_network_ok; then
        _info "ZeroTier network verified ONLINE (OK)."
        return 0
    fi

    _warn "ZeroTier network has not reached OK status yet."
    return 1
}

# Return success if conntrack contains a flow involving one of this node's
# ZeroTier addresses. Requiring conntrack is intentional: absent/inconclusive
# connection tracking must never be interpreted as an idle tunnel.
zerotier_has_tracked_connections() {
    [ -n "$CONNTRACK_BIN" ] || return 2

    zt_network_line=$("$ZEROTIER_BIN" listnetworks 2>/dev/null |
        awk -v nwid="$TW_ZT_NETWORK_ID" '$1 == "200" && $2 == "listnetworks" && $3 == nwid { print $0; found=1; exit } END { if (!found) exit 1 }') || return 2
    zt_iface=$(printf '%s\n' "$zt_network_line" | awk '{print $8}')
    [ -n "$zt_iface" ] && [ "$zt_iface" != "-" ] || return 2

    [ -n "$ZT_INTERFACE_IP_FN" ] || return 2
    zt_local_ips=$("$ZT_INTERFACE_IP_FN" "$zt_iface")
    [ -n "$zt_local_ips" ] || return 2

    zt_conntrack_output=$("$CONNTRACK_BIN" -L 2>/dev/null) || return 2
    printf '%s\n' "$zt_conntrack_output" |
        awk -v addresses="$zt_local_ips" '
            BEGIN {
                count = split(addresses, address, /[[:space:]]+/)
                for (i = 1; i <= count; i++) wanted[address[i]] = 1
            }
            {
                for (i = 1; i <= NF; i++) {
                    token = $i
                    sub(/^(src|dst)=/, "", token)
                    if (token in wanted) found = 1
                }
            }
            END { exit !found }
        '
}

cleanup_zerotier() {
    [ "$TW_STOP_ZT_ON_RECOVERY" -eq 1 ] || return 0
    [ -f "$ZT_OWNED_MARKER" ] || return 0

    if [ -z "$CONNTRACK_BIN" ]; then
        _debug "Cannot safely inspect ZeroTier connections; leaving ZeroTier running."
        return 0
    fi

    zt_now=$(date +%s) || return 0
    case "$zt_now" in ''|*[!0-9]*) return 0 ;; esac

    if [ ! -f "$ZT_RECOVERY_FILE" ]; then
        printf '%s\n' "$zt_now" > "$ZT_RECOVERY_FILE" || return 0
        rm -f "$ZT_IDLE_COUNT_FILE" "$ZT_LAST_CHECK_FILE" "$ZT_LAST_RX_FILE" "$ZT_LAST_TX_FILE"
        _info "Tailscale recovered; ZeroTier cleanup grace period started."
        return 0
    fi

    zt_recovery_time=$(cat "$ZT_RECOVERY_FILE" 2>/dev/null)
    case "$zt_recovery_time" in ''|*[!0-9]*)
        _warn "Invalid ZeroTier recovery timestamp; restarting cleanup grace period."
        printf '%s\n' "$zt_now" > "$ZT_RECOVERY_FILE"
        rm -f "$ZT_IDLE_COUNT_FILE" "$ZT_LAST_CHECK_FILE" "$ZT_LAST_RX_FILE" "$ZT_LAST_TX_FILE"
        return 0
        ;;
    esac
    [ "$((zt_now - zt_recovery_time))" -ge "$TW_ZT_RECOVERY_GRACE" ] || return 0

    zt_network_line=$("$ZEROTIER_BIN" listnetworks 2>/dev/null |
        awk -v nwid="$TW_ZT_NETWORK_ID" '$1 == "200" && $2 == "listnetworks" && $3 == nwid { print $0; found=1; exit } END { if (!found) exit 1 }') || {
        _warn "Unable to determine ZeroTier interface; leaving service running."
        return 0
    }
    zt_iface=$(printf '%s\n' "$zt_network_line" | awk '{print $8}')
    [ -n "$zt_iface" ] && [ "$zt_iface" != "-" ] || {
        _warn "ZeroTier interface is unavailable; leaving service running."
        return 0
    }

    zt_rx_file="/sys/class/net/$zt_iface/statistics/rx_bytes"
    zt_tx_file="/sys/class/net/$zt_iface/statistics/tx_bytes"
    [ -r "$zt_rx_file" ] && [ -r "$zt_tx_file" ] || {
        _warn "ZeroTier interface counters unavailable; leaving service running."
        return 0
    }
    zt_rx=$(cat "$zt_rx_file" 2>/dev/null) || return 0
    zt_tx=$(cat "$zt_tx_file" 2>/dev/null) || return 0
    case "$zt_rx:$zt_tx" in *[!0-9:]*|:*) return 0 ;; esac

    if zerotier_has_tracked_connections; then
        _info "Tracked ZeroTier connection detected; postponing automatic stop."
        echo 0 > "$ZT_IDLE_COUNT_FILE"
        printf '%s\n' "$zt_rx" > "$ZT_LAST_RX_FILE"
        printf '%s\n' "$zt_tx" > "$ZT_LAST_TX_FILE"
        printf '%s\n' "$zt_now" > "$ZT_LAST_CHECK_FILE"
        return 0
    else
        zt_conntrack_rc=$?
        if [ "$zt_conntrack_rc" -ne 1 ]; then
            _warn "Unable to establish ZeroTier connection state; leaving service running."
            return 0
        fi
    fi

    if [ -f "$ZT_LAST_CHECK_FILE" ]; then
        zt_last_check=$(cat "$ZT_LAST_CHECK_FILE" 2>/dev/null)
        case "$zt_last_check" in ''|*[!0-9]*) zt_last_check=0 ;; esac
        [ "$((zt_now - zt_last_check))" -ge "$TW_ZT_IDLE_INTERVAL" ] || return 0
    fi

    zt_last_rx=$(cat "$ZT_LAST_RX_FILE" 2>/dev/null || :)
    zt_last_tx=$(cat "$ZT_LAST_TX_FILE" 2>/dev/null || :)
    if [ -n "$zt_last_rx" ] &&
       { [ "$zt_rx" != "$zt_last_rx" ] || [ "$zt_tx" != "$zt_last_tx" ]; }; then
        _info "ZeroTier traffic detected; restarting idle observation."
        echo 0 > "$ZT_IDLE_COUNT_FILE"
    else
        zt_idle_count=$(cat "$ZT_IDLE_COUNT_FILE" 2>/dev/null || echo 0)
        case "$zt_idle_count" in ''|*[!0-9]*) zt_idle_count=0 ;; esac
        zt_idle_count=$((zt_idle_count + 1))
        printf '%s\n' "$zt_idle_count" > "$ZT_IDLE_COUNT_FILE"
        _debug "ZeroTier idle observation $zt_idle_count/$TW_ZT_IDLE_CHECKS."
    fi
    printf '%s\n' "$zt_rx" > "$ZT_LAST_RX_FILE"
    printf '%s\n' "$zt_tx" > "$ZT_LAST_TX_FILE"
    printf '%s\n' "$zt_now" > "$ZT_LAST_CHECK_FILE"

    zt_idle_count=$(cat "$ZT_IDLE_COUNT_FILE" 2>/dev/null || echo 0)
    [ "$zt_idle_count" -ge "$TW_ZT_IDLE_CHECKS" ] || return 0

    _warn "ZeroTier has remained idle with no tracked connections; stopping watchdog-started service."
    if manage_zerotier stop; then
        rm -f "$ZT_OWNED_MARKER" "$ZT_RESTORE_MARKER" "$ZT_RECOVERY_FILE" \
            "$ZT_IDLE_COUNT_FILE" "$ZT_LAST_CHECK_FILE" "$ZT_LAST_RX_FILE" "$ZT_LAST_TX_FILE"
        _info "ZeroTier stopped and watchdog ownership released."
    else
        _err "Unable to stop ZeroTier; ownership retained for a later retry."
        echo 0 > "$ZT_IDLE_COUNT_FILE"
    fi
    return 0
}

# --- FAILURE COUNTER ---

load_fail_count() {
    FAIL_COUNT=0

    if [ -f "$COUNTER_FILE" ]; then
        stored_count=$(cat "$COUNTER_FILE" 2>/dev/null)

        case "$stored_count" in
            ''|*[!0-9]*|0*)
                _warn "Invalid failure counter. Resetting."
                FAIL_COUNT=0
                ;;
            *)
                FAIL_COUNT=$stored_count
                ;;
        esac
    fi
}

save_fail_count() {
    printf '%s\n' "$FAIL_COUNT" > "$COUNTER_FILE" ||
        _die "Unable to save failure counter."
}

reset_fail_count() {
    FAIL_COUNT=0
    rm -f "$COUNTER_FILE" "$PERSIST_MARKER" "$ZT_ESCALATED_MARKER" "$ZT_RESTORE_MARKER"
    _info "Tailscale recovered. Failure counter and escalation markers cleared."
}


# --- DISCORD NOTIFICATIONS ---

# Notifications are best-effort: a missing curl binary, network error, or
# rejected webhook must never prevent the remediation action itself.
discord_notify() {
    [ -n "$TW_DISCORD_WEBHOOK" ] || return 0

    [ -n "$CURL_BIN" ] || return 0

    # Messages generated by this script are single-line. Escape JSON string
    # characters before constructing the request body.
    discord_json_message=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
    discord_payload="{\"content\":\"$discord_json_message\"}"

    discord_output=$("$CURL_BIN" -fsS --connect-timeout 5 --max-time 10 \
        -H 'Content-Type: application/json' \
        --data-binary "$discord_payload" \
        "$TW_DISCORD_WEBHOOK" 2>&1)
    discord_status=$?

    if [ "$discord_status" -ne 0 ]; then
        _warn "Discord notification failed (curl exit $discord_status): $discord_output"
    fi

    return 0
}


# --- REMEDIATION ---

remediate_failure() {
    # The persistent marker survives reboot while COUNTER_FILE does not.
    # Restore the count at which reboot was attempted, then count this failed
    # post-reboot check as the next consecutive failure.
    if [ -f "$PERSIST_MARKER" ]; then
        if [ "$REBOOT_THRESHOLD" -gt 0 ]; then
            stored_reboot_threshold=$(cat "$PERSIST_MARKER" 2>/dev/null)
            case "$stored_reboot_threshold" in
                ''|*[!0-9]*)
                    _warn "Invalid reboot marker. Continuing with the volatile failure counter."
                    ;;
                *)
                    FAIL_COUNT=$stored_reboot_threshold
                    ;;
            esac
        fi
        rm -f "$PERSIST_MARKER"
    fi

    FAIL_COUNT=$((FAIL_COUNT + 1))
    save_fail_count

    _warn "Consecutive Tailscale failures: $FAIL_COUNT"

    # Trigger each escalation independently; either threshold may come first.
    if [ "$ZT_THRESHOLD" -gt 0 ] && [ "$FAIL_COUNT" -eq "$ZT_THRESHOLD" ]; then
        _warn "Escalation: Activating ZeroTier fallback."
        mkdir -p "$PERSIST_DIR" || _die "Unable to create persistent directory."
        touch "$ZT_ESCALATED_MARKER" || _die "Unable to write ZeroTier escalation marker."
        discord_notify "Tailscale watchdog: activating ZeroTier fallback after $FAIL_COUNT consecutive failed checks."
        activate_zerotier
        return $?
    fi

    # Reboot exactly once at the configured threshold. The marker prevents a
    # second reboot after startup, including when the reboot command fails.
    if [ "$REBOOT_THRESHOLD" -gt 0 ] && [ "$FAIL_COUNT" -eq "$REBOOT_THRESHOLD" ]; then
        _warn "Escalation: Rebooting system after $FAIL_COUNT consecutive failed checks."
        discord_notify "Tailscale watchdog: rebooting after $FAIL_COUNT consecutive failed checks."

        mkdir -p "$PERSIST_DIR" ||
            _die "Unable to create persistent directory."

        printf '%s\n' "$REBOOT_THRESHOLD" > "$PERSIST_MARKER" ||
            _die "Unable to write reboot marker."

        # Restore the escalated ZeroTier network after reboot without
        # enabling the service permanently at boot.
        if [ -f "$ZT_ESCALATED_MARKER" ]; then
            touch "$ZT_RESTORE_MARKER" || _die "Unable to write ZeroTier restoration marker."
        fi

        sync
        reboot
        return $?
    fi

    # Retry ZeroTier activation if the initial attempt did not bring the
    # configured network online. The reboot threshold takes precedence.
    if [ "$ZT_THRESHOLD" -gt 0 ] &&
       [ "$FAIL_COUNT" -gt "$ZT_THRESHOLD" ] &&
       [ -f "$ZT_ESCALATED_MARKER" ] &&
       { [ "$REBOOT_THRESHOLD" -le 0 ] ||
         [ "$FAIL_COUNT" -lt "$REBOOT_THRESHOLD" ]; } &&
       ! is_zerotier_network_ok; then
        _warn "ZeroTier network is not yet online; retrying activation."
        activate_zerotier
        return $?
    fi

    # Once ZeroTier has been activated, hold position until a later reboot
    # threshold (if any). If reboot was earlier, keep restarting Tailscale
    # until the later ZeroTier threshold is reached.
    if [ "$ZT_THRESHOLD" -gt 0 ] && [ "$FAIL_COUNT" -gt "$ZT_THRESHOLD" ] &&
       { [ "$REBOOT_THRESHOLD" -le 0 ] || [ "$FAIL_COUNT" -lt "$REBOOT_THRESHOLD" ]; }; then
        _warn "ZeroTier escalation already active; waiting for recovery or a later reboot threshold."
        return 0
    fi

    # Before escalation thresholds (and indefinitely when both are disabled),
    # restart Tailscale on every failed check.
    _warn "Restarting Tailscale daemon."
    discord_notify "Tailscale watchdog: restarting tailscaled after $FAIL_COUNT consecutive failed checks."

    if ! manage_tailscale restart; then
        _err "Tailscale daemon restart failed."
        return 1
    fi

    return 0
}


# --- MAIN WATCHDOG LOGIC ---

main() {
    _debug "Executing Tailscale watchdog checks..."

    # A watchdog-triggered reboot may have interrupted ZeroTier. Retry
    # restoration until its configured network reaches OK.
    if [ -f "$ZT_RESTORE_MARKER" ]; then
        ZT_RESTORING=1
        activate_zerotier
        zt_restore_status=$?
        ZT_RESTORING=0
        [ "$zt_restore_status" -eq 0 ] && rm -f "$ZT_RESTORE_MARKER"
    fi

    TS_FAILED=0

    # CHECK 1: Tailscale interface.
    if ! has_tailscale_interface; then
        _warn "Tailscale interface tailscale0 is missing."
        TS_FAILED=1
    else
        _debug "Check 1: Tailscale interface OK."

        # CHECK 2: Data-plane or daemon status.
        if [ "$HAS_PING_TARGETS" -eq 1 ]; then
            if [ "$PING_ALWAYS" -eq 1 ]; then
                _debug "TW_PING_ALWAYS enabled; checking configured PING Targets."
                check_tailscale_targets || TS_FAILED=1
            else
                check_tailscale_active_connections
                active_status=$?
                case "$active_status" in
                    0)
                        _debug "Active Tailscale connections detected; skipping PING Targets."
                        ;;
                    1)
                        _debug "No active Tailscale connections; checking configured PING Targets."
                        check_tailscale_targets || TS_FAILED=1
                        ;;
                    *)
                        _warn "Falling back to PING Targets because active connections could not be checked."
                        check_tailscale_targets || TS_FAILED=1
                        ;;
                esac
            fi
        else
            check_tailscale_status || TS_FAILED=1
        fi
    fi

    # SUCCESS: Tailscale is healthy.
    if [ "$TS_FAILED" -eq 0 ]; then
        if [ "$FAIL_COUNT" -gt 0 ] ||
            [ -f "$COUNTER_FILE" ] || [ -f "$PERSIST_MARKER" ] ||
            [ -f "$ZT_ESCALATED_MARKER" ] || [ -f "$ZT_RESTORE_MARKER" ]; then
            reset_fail_count
        fi
        cleanup_zerotier

        if [ -f "$WAN_FLAG_FILE" ]; then
            _info "WAN connectivity restored."
            rm -f "$WAN_FLAG_FILE"
        fi

		_info "All Tailscale checks passed."
        return 0
    fi

    _warn "Tailscale health check failed."

    # EXCEPTION: WAN unavailable.
    if ! is_wan_available; then
        _warn "Public Internet WAN unavailable."
        restart_network
        return 1
    fi

    # WAN restored: clear stale marker.
    if [ -f "$WAN_FLAG_FILE" ]; then
        _info "WAN connectivity restored."
        rm -f "$WAN_FLAG_FILE"
    fi

    # WAN available: proceed with Tailscale remediation.
    remediate_failure
}

# --- PROCESS LIFECYCLE ---

startup() {
    _quit_if_no_root_privileges
    validate_config
    init_environment
    load_fail_count
}

run_loop() {
    # Run in the foreground. systemd/procd supervise this process directly.
	# First check starts AFTER TW_STARTUP_DELAY seconds to allow tailscale
	# time to initialise. A failed health check is not a process failure; 
	# main() reports it and the next check runs after TW_CHECK_INTERVAL seconds.
    trap 'exit 0' HUP INT TERM

    _info "Watchdog starting. Initial delay: ${TW_STARTUP_DELAY}s"
    sleep "$TW_STARTUP_DELAY"

    while :; do
        main || :
        TAG_CACHE_AGE=$((TAG_CACHE_AGE + HAS_TAG_TARGETS))
        sleep "$TW_CHECK_INTERVAL" ||
            _die "Unable to sleep for TW_CHECK_INTERVAL=$TW_CHECK_INTERVAL seconds."
    done
}

case "${1:-}" in
    --once)
        startup
        main
        ;;
    --loop|'')
        startup
        [ "$LOG" -le 2 ] && print_config
        run_loop
        ;;
    --help|-h)
        cat <<EOF
Usage: $0 [--loop|--once|--help]
  --loop  Run continuously (default); intended for systemd/procd.
  --once  Run one health check and exit.
  --help  Show this help.

Configuration file: $CONFIG_FILE
TW_CHECK_INTERVAL=$TW_CHECK_INTERVAL seconds between completed checks.
TW_TAG_CACHE_INTERVAL=$TW_TAG_CACHE_INTERVAL checks between tag cache refreshes.
EOF
        ;;
    *)
        echo "Unknown option: $1" >&2
        echo "Usage: $0 [--loop|--once|--help]" >&2
        exit 2
        ;;
esac

